{
  "name": "@genoffice/renderer-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "GenOffice renderer compatibility bridge \u2014 explicit typed object factories that return the existing window.* API shapes, delegating to domain services and platform capabilities. Pure factories; no window mutation inside this package.",
