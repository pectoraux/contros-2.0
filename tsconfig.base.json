{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noEmit": true,
    "paths": {
      "@genoffice/docs-shared": ["./apps/docs/src/shared/ipc.ts"],
      "@genoffice/sheets-shared": ["./apps/sheets/src/shared/desktop-api.ts"],
      "@genoffice/slides-shared": ["./apps/slides/src/shared/ipc.ts"],
      "@genoffice/pdf-shared": ["./apps/pdf/src/shared/ipc.ts"],
      "@genoffice/markdown-shared": ["./apps/markdown/src/shared/ipc.ts"],
      "@genoffice/shell-home-shared": ["./apps/shell/src/shared/home-api.ts"],
      "@genoffice/shell-tabs-shared": ["./apps/shell/src/shared/tabs-api.ts"],
      "@genoffice/shell-update-shared": ["./apps/shell/src/shared/update-api.ts"],
      "@genoffice/xlsx-gateway": ["./apps/sheets/src/gateway/xlsx-gateway.ts"],
      "@genoffice/xlsx-sheets": ["./apps/sheets/src/gateway/xlsx-sheets.ts"],
      "@genoffice/xlsx-structure": ["./apps/sheets/src/gateway/xlsx-structure.ts"],
      "@genoffice/xlsx-filter": ["./apps/sheets/src/gateway/xlsx-filter.ts"],
      "@genoffice/xlsx-defined-names": ["./apps/sheets/src/gateway/xlsx-defined-names.ts"],
      "@genoffice/xlsx-page-setup": ["./apps/sheets/src/gateway/xlsx-page-setup.ts"],
      "@genoffice/xlsx-theme": ["./apps/sheets/src/gateway/xlsx-theme.ts"],
      "@genoffice/xlsx-package-io": ["./apps/sheets/src/gateway/xlsx-package-io.ts"]
    }
  }
}
