{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build:api && cd apps/web && bun run build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "bun install --ignore-scripts",
  "functions": {
    "api/serverless.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/serverless" }
  ]
}
